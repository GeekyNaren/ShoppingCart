################################################################################
# .gitignore for Visual Studio / .NET projects
# Exclude files that do not need to be committed to source control
################################################################################

# Visual Studio cache and user-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
**/bin/
**/obj/
**/out/
**/publish/
*.dll
*.exe

# NuGet
*.nupkg
packages/

# Rider / JetBrains
.idea/
*.DotSettings.user

# VS Code
.vscode/

# ASP.NET / user secrets
appsettings.Development.json
Local.settings.json
secrets.json
secrets.*
Properties/launchSettings.json

# Logs, databases and test results
*.log
TestResults/
*.sql
*.sqlite
*.db

# Coverage and tooling
*.coverage
*.coveragexml
coverage*.json

# OS generated files
Thumbs.db
.DS_Store

# Node
node_modules/

# Generated AssemblyInfo files and other generated source
*AssemblyInfo*.cs
*.AssemblyInfo.*

# Misc
*.pid
*.seed

